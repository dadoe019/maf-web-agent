    async def _attempt_recovery(
        self,
        task: str,
        url: str,
        domain: str,
        error: str,
        start_time: datetime,
        screenshot: Optional[str] = None
    ) -> Dict[str, Any]:
        """Attempt automatic failure recovery"""
        self.logger.info(f"🔧 Attempting failure recovery...")
        
        context = FailureContext(
            task=task,
            url=url,
            domain=domain,
            error=error,
            screenshot=screenshot
        )
        
        recovery_result = await self.failure_recovery.recover(context)
        
        if recovery_result.success:
            duration = (datetime.now() - start_time).total_seconds()
            
            return {
                "success": True,
                "text": recovery_result.new_result.get('output', ''),
                "recovered": True,
                "recovery_strategy": recovery_result.strategy_used.value,
                "cost": recovery_result.cost,
                "duration_seconds": duration,
                "timestamp": datetime.now().isoformat()
            }
        
        return {
            "success": False,
            "error": recovery_result.error,
            "recovery_attempted": True,
            "recovery_strategy": recovery_result.strategy_used.value
        }
    
    def _parse_llm_result(self, text: str) -> Optional[Dict[str, Any]]:
        """Parse LLM result to extract MCP steps"""
        import json
        import re
        
        # Try to find JSON in response
        json_match = re.search(r'\{.*"steps".*\}', text, re.DOTALL)
        if json_match:
            try:
                return json.loads(json_match.group())
            except json.JSONDecodeError:
                pass
        
        return None
    
