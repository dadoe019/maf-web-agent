"""
Simplified Settings - Pydantic Configuration
"""

from typing import List, Optional
from pydantic import Field
from pydantic_settings import BaseSettings, SettingsConfigDict


class LLMSettings(BaseSettings):
    """LLM configuration"""
    model_config = SettingsConfigDict(env_prefix='')
    
    openrouter_api_key: str = Field(..., description="OpenRouter API key")
    model: str = Field(
        default="x-ai/grok-4-fast-reasoning",
        description="Primary model"
    )
    
    anthropic_api_key: Optional[str] = Field(None, description="Fallback API key")
    fallback_model: str = Field(
        default="claude-3-5-sonnet-20241022",
        description="Fallback model"
    )


class BudgetSettings(BaseSettings):
    """Budget configuration"""
    model_config = SettingsConfigDict(env_prefix='')
    
    daily_budget_usd: float = Field(default=10.0, gt=0)


class MCPServerSettings(BaseSettings):
    """MCP server configuration"""
    model_config = SettingsConfigDict(env_prefix='MCP_')
    
    playwright_enabled: bool = True
    playwright_command: str = "npx"
    playwright_args: str = "-y,@playwright/mcp@latest"
    
    browser_use_enabled: bool = True
    browser_use_command: str = "uvx"
    browser_use_args: str = "browser-use,--mcp"
    
    def get_playwright_args(self) -> List[str]:
        return self.playwright_args.split(',')
    
    def get_browser_use_args(self) -> List[str]:
        return self.browser_use_args.split(',')


class Settings(BaseSettings):
    """Application settings"""
    model_config = SettingsConfigDict(
        env_file='.env',
        env_file_encoding='utf-8'
    )
    
    # Redis
    redis_url: str = "redis://localhost:6379/0"
    
    # Logging
    log_level: str = "INFO"
    
    # Nested configs
    llm: LLMSettings = Field(default_factory=LLMSettings)
    budget: BudgetSettings = Field(default_factory=BudgetSettings)
    mcp: MCPServerSettings = Field(default_factory=MCPServerSettings)


# Global instance
settings = Settings()
