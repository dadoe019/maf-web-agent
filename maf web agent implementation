"""
MCP Client Manager - Updated for MAF

Manages MCP tool lifecycle with health monitoring.
Uses MAF's MCPStdioTool instead of custom wrappers.
"""

import asyncio
import logging
from typing import Dict, List, Optional, Set
from dataclasses import dataclass
from contextlib import asynccontextmanager

from agent_framework import MCPStdioTool, MCPStreamableHTTPTool
from opentelemetry import trace

logger = logging.getLogger("mcp.client_manager")
tracer = trace.get_tracer(__name__)


@dataclass
class MCPServerConfig:
    """MCP server configuration"""
    name: str
    transport: str  # stdio, http
    command: Optional[str] = None
    args: List[str] = None
    url: Optional[str] = None
    enabled: bool = True
    
    def __post_init__(self):
        if self.args is None:
            self.args = []


class MCPClientManager:
    """
    Manages lifecycle of MCP tools for MAF agents.
    
    Provides:
    - Connection pooling
    - Health checking
    - Tool discovery caching
    - Graceful shutdown
    """
    
    def __init__(self, configs: List[MCPServerConfig]):
        self.configs = {c.name: c for c in configs if c.enabled}
        self.tools: Dict[str, any] = {}
        self.health_status: Dict[str, bool] = {}
        self.logger = logger
        
    @asynccontextmanager
    async def get_mcp_tool(self, name: str):
        """
        Get MCP tool with proper lifecycle management.
        
        Usage:
            async with manager.get_mcp_tool("playwright") as tool:
                # Use tool
                pass
        """
        config = self.configs.get(name)
        if not config:
            raise ValueError(f"Unknown MCP server: {name}")
        
        # Create appropriate tool type
        if config.transport == "stdio":
            tool = MCPStdioTool(
                name=config.name,
                command=config.command,
                args=config.args
            )
        elif config.transport == "http":
            tool = MCPStreamableHTTPTool(
                name=config.name,
                url=config.url
            )
        else:
            raise ValueError(f"Unsupported transport: {config.transport}")
        
        # Manage lifecycle
        try:
            async with tool:
                self.tools[name] = tool
                self.health_status[name] = True
                yield tool
        finally:
            self.tools.pop(name, None)
            
    async def check_health(self, name: str) -> bool:
        """Check if MCP server is healthy"""
        try:
            async with self.get_mcp_tool(name) as tool:
                # Tool started successfully
                return True
        except Exception as e:
            self.logger.warning(f"Health check failed for {name}: {e}")
            self.health_status[name] = False
            return False
            
    async def check_all_health(self) -> Dict[str, bool]:
        """Check health of all configured servers"""
        results = {}
        for name in self.configs:
            results[name] = await self.check_health(name)
        return results
        
    def get_healthy_servers(self) -> List[str]:
        """Get list of healthy server names"""
        return [name for name, healthy in self.health_status.items() if healthy]
