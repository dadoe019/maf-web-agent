            'output': 'Executed cached pattern'
        }
    
    def _error_response(self, error: str, start_time: datetime) -> Dict[str, Any]:
        """Build error response"""
        return {
            "success": False,
            "error": error,
            "duration_seconds": (datetime.now() - start_time).total_seconds(),
            "timestamp": datetime.now().isoformat()
        }
    
    async def get_stats(self) -> Dict[str, Any]:
        """Get comprehensive agent statistics"""
        cache_stats = await self.pattern_cache.get_cache_stats()
        recovery_stats = await self.failure_recovery.get_recovery_stats()
        vision_stats = await self.vision_fallback.get_vision_stats()
        
        return {
            "cache": cache_stats,
            "recovery": recovery_stats,
            "vision": vision_stats,
            "cost_savings": {
                "from_cache": cache_stats.get('savings_from_cache', 0),
                "from_cheap_vision": vision_stats.get('savings_vs_premium', 0)
            }
        }
