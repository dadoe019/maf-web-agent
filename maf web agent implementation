"""
Cost Tracking Middleware - Wraps MAF agent calls

Tracks token usage and costs, enforces budget limits.
"""

import logging
from typing import Dict, Any, Optional
from datetime import datetime, date
from functools import wraps

from opentelemetry import metrics
from src.state.redis_client import RedisClient

logger = logging.getLogger("middleware.cost_tracker")
meter = metrics.get_meter(__name__)

cost_counter = meter.create_counter(
    "llm_cost_usd_total",
    description="Total LLM cost in USD"
)


class CostTracker:
    """
    Tracks LLM costs and enforces budget limits.
    
    Wraps around MAF agent.run() calls to track costs.
    """
    
    # Pricing per 1M tokens
    PRICING = {
        "x-ai/grok-4-fast-reasoning": {"input": 0.20, "output": 0.50},
        "x-ai/grok-4-fast-non-reasoning": {"input": 0.10, "output": 0.20},
        "claude-3-5-sonnet-20241022": {"input": 3.00, "output": 15.00},
    }
    
    def __init__(
        self,
        redis_client: RedisClient,
        daily_budget_usd: float = 10.0
    ):
        self.redis = redis_client
        self.daily_budget = daily_budget_usd
        self.logger = logger
        
    async def check_budget(self) -> tuple[bool, float]:
        """
        Check if budget allows more requests.
        
        Returns:
            (can_proceed, current_spend)
        """
        today = date.today().isoformat()
        current_spend = await self.redis.get_float(f"costs:daily:{today}", 0.0)
        
        can_proceed = current_spend < self.daily_budget
        
        if not can_proceed:
            self.logger.warning(
                f"Daily budget exceeded: ${current_spend:.4f} >= ${self.daily_budget}"
            )
            
        return can_proceed, current_spend
        
    async def track_cost(
        self,
        model: str,
        input_tokens: int,
        output_tokens: int,
        metadata: Optional[Dict[str, Any]] = None
    ) -> float:
        """
        Track cost for a completion.
        
        Returns:
            Cost in USD
        """
        pricing = self.PRICING.get(model, {"input": 0, "output": 0})
        
        input_cost = (input_tokens / 1_000_000) * pricing["input"]
        output_cost = (output_tokens / 1_000_000) * pricing["output"]
        total_cost = input_cost + output_cost
        
        # Store in Redis
        today = date.today().isoformat()
        await self.redis.increment_float(f"costs:daily:{today}", total_cost)
        
        # Record metrics
        cost_counter.add(total_cost, {"model": model})
        
        self.logger.info(
            f"Cost tracked: ${total_cost:.4f} "
            f"({input_tokens} in + {output_tokens} out tokens)"
        )
        
        return total_cost
        
    def wrap_agent_run(self, agent_run_func):
        """
        Decorator to wrap agent.run() with cost tracking.
        
        Usage:
            cost_tracker = CostTracker(redis_client)
            
            @cost_tracker.wrap_agent_run
            async def run_agent(task):
                return await agent.run(task)
        """
        @wraps(agent_run_func)
        async def wrapper(*args, **kwargs):
            # Check budget before execution
            can_proceed, current_spend = await self.check_budget()
            if not can_proceed:
                raise Exception(
                    f"Daily budget exceeded: ${current_spend:.2f} / ${self.daily_budget}"
                )
            
            # Execute agent
            result = await agent_run_func(*args, **kwargs)
            
            # Track cost (estimate if tokens not available)
            # MAF result objects may have token info in metadata
            model = kwargs.get("model", "unknown")
            
            # Estimate tokens if not available
            input_tokens = getattr(result, 'input_tokens', None) or len(args[0]) * 4
            output_tokens = getattr(result, 'output_tokens', None) or len(result.text) * 4
            
            await self.track_cost(model, input_tokens, output_tokens)
            
            return result
            
        return wrapper
